# Shared
NODE_ENV=development
APP_ORIGIN=http://localhost:8080
APP_DOMAIN=localhost

# API
API_PORT=3001
DATABASE_URL=postgresql://dse_crm:dse_crm_dev_only@localhost:5432/dse_crm_dev?schema=public
SESSION_COOKIE_NAME=dse_session
SESSION_ABSOLUTE_TTL_SECONDS=28800
SESSION_IDLE_TTL_SECONDS=7200
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
CSRF_COOKIE_NAME=dse_csrf
TRUST_PROXY=false
LOG_LEVEL=info

# Development seed only. The seed command refuses staging and production.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-local-12-character-password
SEED_BUTLER_USERNAME=butler
SEED_BUTLER_PASSWORD=replace-with-a-local-12-character-password

# Future S3-compatible storage adapter. S0 does not expose file APIs.
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Web
NEXT_PUBLIC_API_BASE_URL=/api/v1

