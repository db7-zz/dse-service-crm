# Shared
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
COMPOSE_APP_ORIGIN=http://localhost:8080
APP_DOMAIN=localhost

# API
API_PORT=3001
DATABASE_URL=postgresql://dse_crm:dse_crm_dev_only@localhost:5432/dse_crm_dev?schema=public
SESSION_COOKIE_NAME=dse_session
SESSION_ABSOLUTE_TTL_SECONDS=28800
SESSION_IDLE_TTL_SECONDS=7200
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
CSRF_COOKIE_NAME=dse_csrf
TRUST_PROXY=false
LOG_LEVEL=info

# Development seed only. Reset is restricted to a local database whose name contains dev.
# The deterministic demo creates admin, butler, and student with this shared local password.
SEED_DEMO_PASSWORD=replace-with-a-local-6-character-password

# Authenticated local file store. Production can mount this path on durable encrypted storage.
FILE_STORAGE_ROOT=./tmp/uploads
MAX_UPLOAD_BYTES=52428800

# Optional future object-storage adapter; V1 local storage uses FILE_STORAGE_ROOT.
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Web
NEXT_PUBLIC_API_BASE_URL=/api/v1
