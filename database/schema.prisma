generator client {
  provider     = "prisma-client"
  output       = "./generated/client"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum StudentServiceStatus {
  NOT_ENABLED
  ENABLED
}

enum StudentResponsibilityType {
  DEFAULT_BUTLER
  PLANNER
}

model User {
  id                         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                   String      @unique @db.VarChar(64)
  displayName                String      @map("display_name") @db.VarChar(100)
  passwordHash               String      @map("password_hash") @db.VarChar(255)
  status                     UserStatus  @default(ACTIVE)
  failedLoginCount           Int         @default(0) @map("failed_login_count")
  failedLoginWindowStartedAt DateTime?   @map("failed_login_window_started_at")
  lockedUntil                DateTime?   @map("locked_until")
  lastLoginAt                DateTime?   @map("last_login_at")
  createdAt                  DateTime    @default(now()) @map("created_at")
  updatedAt                  DateTime    @updatedAt @map("updated_at")
  roles                      UserRole[]
  sessions                   Session[]
  auditLogs                  AuditLog[]  @relation("AuditOperator")
  studentsCreated            Student[]   @relation("StudentCreator")
  studentsAsDefaultButler    Student[]   @relation("StudentDefaultButler")
  studentsAsPlanner          Student[]   @relation("StudentPlanner")
  responsibilityChangesMade StudentResponsibilityChange[] @relation("ResponsibilityChangeOperator")
  responsibilityChangesFrom StudentResponsibilityChange[] @relation("ResponsibilityChangePreviousUser")
  responsibilityChangesTo   StudentResponsibilityChange[] @relation("ResponsibilityChangeNewUser")

  @@map("users")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique @map("role_code") @db.VarChar(32)
  name        String           @map("role_name") @db.VarChar(50)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique @map("permission_code") @db.VarChar(64)
  name        String           @map("permission_name") @db.VarChar(100)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  effectiveAt DateTime @default(now()) @map("effective_at")
  expiredAt   DateTime? @map("expired_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId      String     @map("role_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  role        Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission  Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash     String    @map("csrf_token_hash") @db.Char(64)
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  idleExpiresAt     DateTime  @map("idle_expires_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  revokedAt         DateTime? @map("revoked_at")
  ipAddress         String?   @map("ip_address") @db.VarChar(64)
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  createdAt         DateTime  @default(now()) @map("created_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operatorId   String?  @map("operator_id") @db.Uuid
  operatorRole String?  @map("operator_role") @db.VarChar(32)
  objectType   String   @map("object_type") @db.VarChar(64)
  objectId     String?  @map("object_id") @db.VarChar(128)
  action       String   @db.VarChar(64)
  beforeData   Json?    @map("before_data")
  afterData    Json?    @map("after_data")
  reason       String?  @db.VarChar(500)
  requestId    String   @map("request_id") @db.VarChar(64)
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  deviceInfo   String?  @map("device_info") @db.VarChar(512)
  createdAt    DateTime @default(now()) @map("created_at")
  operator     User?    @relation("AuditOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([operatorId, createdAt])
  @@index([objectType, objectId])
  @@index([requestId])
  @@map("audit_logs")
}

model Student {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentNo          String               @unique @map("student_no") @db.VarChar(24)
  name               String               @db.VarChar(100)
  phone              String?              @db.VarChar(32)
  email              String?              @db.VarChar(254)
  defaultButlerId    String?              @map("default_butler_id") @db.Uuid
  plannerId          String?              @map("planner_id") @db.Uuid
  serviceStatus      StudentServiceStatus @default(NOT_ENABLED) @map("service_status")
  version            Int                  @default(1)
  createdById        String               @map("created_by") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  defaultButler      User?                @relation("StudentDefaultButler", fields: [defaultButlerId], references: [id], onDelete: SetNull)
  planner            User?                @relation("StudentPlanner", fields: [plannerId], references: [id], onDelete: SetNull)
  createdBy          User                 @relation("StudentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  responsibilityChanges StudentResponsibilityChange[]

  @@index([name])
  @@index([serviceStatus, createdAt])
  @@index([defaultButlerId])
  @@index([plannerId])
  @@map("students")
}

model StudentResponsibilityChange {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId          String                    @map("student_id") @db.Uuid
  responsibilityType StudentResponsibilityType @map("responsibility_type")
  previousUserId     String?                   @map("previous_user_id") @db.Uuid
  newUserId          String?                   @map("new_user_id") @db.Uuid
  reason             String                    @db.VarChar(500)
  operatorId         String                    @map("operator_id") @db.Uuid
  createdAt          DateTime                  @default(now()) @map("created_at")
  student            Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  previousUser       User?                     @relation("ResponsibilityChangePreviousUser", fields: [previousUserId], references: [id], onDelete: SetNull)
  newUser            User?                     @relation("ResponsibilityChangeNewUser", fields: [newUserId], references: [id], onDelete: SetNull)
  operator           User                      @relation("ResponsibilityChangeOperator", fields: [operatorId], references: [id], onDelete: Restrict)

  @@index([studentId, createdAt])
  @@index([operatorId])
  @@map("student_responsibility_changes")
}
