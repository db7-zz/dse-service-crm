generator client {
  provider     = "prisma-client"
  output       = "./generated/client"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum StudentServiceStatus {
  NOT_ENABLED
  ENABLED
  PAUSED
  TERMINATED
}

enum StudentHandoffStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  CANCELED
}

enum StudentProfileStatus {
  INFORMATION_PENDING
  PENDING_REVIEW
  CONFIRMED
  PLANNER_ASSIGNED
}

enum MaterialInputMode {
  FILE
  FORM
  SECURE_REFERENCE
}

enum MaterialCollectionPhase {
  CURRENT
  LATER
}

enum MaterialRequirementKind {
  REQUIRED
  CONDITIONAL
  OPTIONAL
}

enum MaterialDeadlineRule {
  ACTIVATION_OFFSET
  STAGE_OFFSET
  FIXED_DATE
}

enum MaterialItemOrigin {
  SOP_TEMPLATE
  SPECIAL
}

enum StudentRiskLevel {
  NORMAL
  ATTENTION
  HIGH
}

enum ScoreType {
  CURRENT
  PREDICTED
}

enum TargetLevel {
  ASPIRATIONAL
  MATCH
  SAFE
  OTHER
}

enum StudentResponsibilityType {
  DEFAULT_BUTLER
  PLANNER
}

enum SopVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELED
  NOT_APPLICABLE
}

enum StageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum TaskSourceType {
  SOP
  MANUAL
  MATERIAL
  APPLICATION
  ISSUE
}

enum MaterialStatus {
  REQUIRED
  DRAFT
  PENDING_REVIEW
  IN_REVIEW
  APPROVED
  NEEDS_CORRECTION
  PARTIALLY_MISSING
  RESUBMISSION_REQUIRED
  AWAITING_CONFIRMATION
  NOT_APPLICABLE
  CANCELED
}

enum MaterialReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MaterialSubmissionStatus {
  DRAFT
  PENDING_REVIEW
  IN_REVIEW
  NEEDS_CORRECTION
  APPROVED
  WITHDRAWN
}

enum MaterialSubmissionSource {
  STUDENT
  BUTLER
  LEGACY
}

enum MaterialApplicabilityRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MaterialArchiveStatus {
  NOT_ARCHIVED
  ARCHIVED
  ARCHIVE_FAILED
}

enum ApplicationChannel {
  HK_DIRECT
  JUPAS
}

enum ApplicationStatus {
  PLANNING
  CONFIRMED
  MATERIAL_PREPARATION
  PENDING_SUBMISSION
  SUBMITTED
  WAITING_RESULT
  SUPPLEMENT
  INTERVIEW
  OFFER
  REJECTED
  ENROLLED
  WITHDRAWN
}

enum ApplicationRequirementStatus {
  OPEN
  COMPLETED
  WAIVED
}

enum IssueStatus {
  OPEN
  NEEDS_INFO
  RESPONDED
  CONVERTED_TO_TASK
  RESOLVED
  CLOSED
}

enum IssueLogAction {
  CREATED
  INFORMATION_ADDED
  INFORMATION_REQUESTED
  RESPONDED
  CONVERTED_TO_TASK
  RESOLVED
  CLOSED
  REOPENED
}

enum NotificationEventType {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  TASK_EXTENSION_REPORTED
  TASK_REASSIGNED
  MATERIAL_UPLOADED
  MATERIAL_SUBMITTED
  MATERIAL_REVIEWED
  MATERIAL_CORRECTION_REQUIRED
  MATERIAL_APPLICABILITY_REQUESTED
  MATERIAL_APPLICABILITY_REVIEWED
  MATERIAL_MISSING
  MATERIAL_DUE_SOON
  MATERIAL_OVERDUE
  MATERIAL_REVIEW_OVERDUE
  STAGE_CHANGED
  APPLICATION_STATUS_CHANGED
  ISSUE_SUBMITTED
  SPECIALIST_TASK_ASSIGNED
  STUDENT_RESPONSIBILITY_CHANGED
  HANDOFF_ASSIGNED
  HANDOFF_ACCEPTED
  PROFILE_SUBMITTED
  PLANNER_ASSIGNMENT_REQUESTED
  PLANNER_ASSIGNED
  BUTLER_ANOMALY_DAILY
  BUTLER_WEEKLY_REVIEW_FROZEN
  BUTLER_WEEKLY_REVIEW_SUBMITTED
}

enum ConfirmationStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum ProgressCalculationStatus {
  NORMAL
  RECALCULATING
  ERROR
}

enum StageTransitionTriggerType {
  SERVICE_ACTIVATION
  TASK_COMPLETED
  TASK_CANCELED
  TASK_NOT_APPLICABLE
  CONTINUOUS_ADVANCE
  MIGRATION
  RECALCULATION
}

enum ProgressCalculationRunType {
  MIGRATION
  RECALCULATION
}

enum ProgressCalculationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum OverdueAlertStatus {
  OPEN
  HANDLED
  RESOLVED
}

enum RectificationStatus {
  PENDING_RECTIFICATION
  PENDING_REVIEW
  CLOSED
}

enum StudentBlockerStatus {
  ACTIVE
  SUPERSEDED
  RESOLVED
  REJECTED
}

enum ButlerAnomalyType {
  TASK_OVERDUE_UNREPORTED
  STUDENT_BLOCKER_FOLLOWUP_MISSED
  STUDENT_BLOCKER_REJECTED
  WEEKLY_RESPONSE_OVERDUE
}

enum ButlerAnomalyStatus {
  OPEN
  RECTIFIED
  APPEAL_ACCEPTED
  APPEAL_REJECTED
}

enum ButlerWeeklyReviewStatus {
  LIVE
  PENDING_RESPONSE
  PENDING_REVIEW
  CLOSED
}

enum TaskTimelineEventType {
  CREATED
  ASSIGNED
  STARTED
  PROGRESS_UPDATED
  EXTENSION_REPORTED
  RESCHEDULED
  REASSIGNED
  COMPLETED
  CANCELED
  MARKED_NOT_APPLICABLE
  REOPENED
  EVIDENCE_ADDED
  OVERDUE_ALERT_GENERATED
  OVERDUE_ALERT_HANDLED
  OVERDUE_ALERT_RESOLVED
  STUDENT_BLOCKER_REPORTED
  STUDENT_BLOCKER_UPDATED
  STUDENT_BLOCKER_REJECTED
  STUDENT_BLOCKER_RESOLVED
}

model User {
  id                               String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                         String                          @unique @db.VarChar(64)
  displayName                      String                          @map("display_name") @db.VarChar(100)
  passwordHash                     String                          @map("password_hash") @db.VarChar(255)
  mustChangePassword               Boolean                         @default(false) @map("must_change_password")
  temporaryPasswordExpiresAt       DateTime?                       @map("temporary_password_expires_at")
  status                           UserStatus                      @default(ACTIVE)
  failedLoginCount                 Int                             @default(0) @map("failed_login_count")
  failedLoginWindowStartedAt       DateTime?                       @map("failed_login_window_started_at")
  lockedUntil                      DateTime?                       @map("locked_until")
  lastLoginAt                      DateTime?                       @map("last_login_at")
  createdAt                        DateTime                        @default(now()) @map("created_at")
  updatedAt                        DateTime                        @updatedAt @map("updated_at")
  roles                            UserRole[]
  sessions                         Session[]
  auditLogs                        AuditLog[]                      @relation("AuditOperator")
  studentsCreated                  Student[]                       @relation("StudentCreator")
  studentsAsDefaultButler          Student[]                       @relation("StudentDefaultButler")
  studentsAsPlanner                Student[]                       @relation("StudentPlanner")
  responsibilityChangesMade        StudentResponsibilityChange[]   @relation("ResponsibilityChangeOperator")
  responsibilityChangesFrom        StudentResponsibilityChange[]   @relation("ResponsibilityChangePreviousUser")
  responsibilityChangesTo          StudentResponsibilityChange[]   @relation("ResponsibilityChangeNewUser")
  sopVersionsCreated               SopVersion[]                    @relation("SopVersionCreator")
  serviceActivationsEnabled        StudentServiceActivation[]      @relation("ServiceActivationOperator")
  tasksOwned                       TaskInstance[]                  @relation("TaskOwner")
  taskProgressCreated              TaskProgressRecord[]            @relation("TaskProgressOperator")
  taskExtensionsReported           TaskExtensionReport[]           @relation("TaskExtensionReporter")
  taskDueDatesChanged              TaskDueDateChange[]             @relation("TaskDueDateOperator")
  taskReassignmentsOperated        TaskReassignment[]              @relation("TaskReassignmentOperator")
  taskReassignmentsFrom            TaskReassignment[]              @relation("TaskReassignmentPreviousOwner")
  taskReassignmentsTo              TaskReassignment[]              @relation("TaskReassignmentNewOwner")
  tasksCanceled                    TaskInstance[]                  @relation("TaskCancellationOperator")
  overdueAlertsHandled             OverdueAlert[]                  @relation("OverdueAlertHandler")
  taskTimelineEvents               TaskTimelineEvent[]             @relation("TaskTimelineActor")
  taskOperationReceipts            TaskOperationReceipt[]          @relation("TaskOperationActor")
  manualTasksCreated               TaskInstance[]                  @relation("TaskCreator")
  progressCalculationRuns          ServiceProgressCalculationRun[] @relation("ProgressCalculationInitiator")
  portalStudent                    Student?                        @relation("StudentPortalUser")
  studentScoresUpdated             StudentScore[]                  @relation("StudentScoreUpdater")
  studentTargetsUpdated            StudentTarget[]                 @relation("StudentTargetUpdater")
  materialItemsOwned               MaterialItem[]                  @relation("MaterialOwner")
  materialItemsCreated             MaterialItem[]                  @relation("MaterialItemCreator")
  materialItemsCanceled            MaterialItem[]                  @relation("MaterialItemCanceler")
  materialVersionsUploaded         MaterialVersion[]               @relation("MaterialVersionUploader")
  materialVersionsReviewed         MaterialVersion[]               @relation("MaterialVersionReviewer")
  materialSubmissionsCreated       MaterialSubmission[]            @relation("MaterialSubmissionCreator")
  materialSubmissionsSubmitted     MaterialSubmission[]            @relation("MaterialSubmissionSubmitter")
  materialSubmissionReviewsStarted MaterialSubmission[]            @relation("MaterialSubmissionReviewStarter")
  materialSubmissionsReviewed      MaterialSubmission[]            @relation("MaterialSubmissionReviewer")
  materialSubmissionFilesUploaded  MaterialSubmissionFile[]        @relation("MaterialSubmissionFileUploader")
  materialSubmissionFilesReviewed  MaterialSubmissionFile[]        @relation("MaterialSubmissionFileReviewer")
  materialSubmissionFilesRemoved   MaterialSubmissionFile[]        @relation("MaterialSubmissionFileRemover")
  materialApplicabilityRequested   MaterialApplicabilityRequest[]  @relation("MaterialApplicabilityRequester")
  materialApplicabilityReviewed    MaterialApplicabilityRequest[]  @relation("MaterialApplicabilityReviewer")
  materialFollowupsCreated         MaterialFollowup[]              @relation("MaterialFollowupOperator")
  applicationsOwned                Application[]                   @relation("ApplicationOwner")
  applicationStatusChanges         ApplicationStatusLog[]          @relation("ApplicationStatusOperator")
  issuesSubmitted                  Issue[]                         @relation("IssueSubmitter")
  issueLogsCreated                 IssueLog[]                      @relation("IssueLogOperator")
  notifications                    Notification[]                  @relation("NotificationRecipient")
  confirmationsResponded           StudentConfirmation[]           @relation("ConfirmationResponder")
  taskEvidenceUploaded             TaskEvidence[]                  @relation("TaskEvidenceUploader")
  issuesAssigned                   Issue[]                         @relation("IssueOwner")
  rectificationsAssigned           RectificationRecord[]           @relation("RectificationButler")
  rectificationsCreated            RectificationRecord[]           @relation("RectificationCreator")
  rectificationsReviewed           RectificationRecord[]           @relation("RectificationReviewer")
  studentBlockersReported          TaskStudentBlocker[]            @relation("StudentBlockerReporter")
  studentBlockersReviewed          TaskStudentBlocker[]            @relation("StudentBlockerReviewer")
  butlerAnomalies                  ButlerAnomaly[]                 @relation("ButlerAnomalyButler")
  butlerAnomaliesResolved          ButlerAnomaly[]                 @relation("ButlerAnomalyResolver")
  weeklyReviewsAssigned            ButlerWeeklyReview[]            @relation("ButlerWeeklyReviewButler")
  weeklyReviewsReviewed            ButlerWeeklyReview[]            @relation("ButlerWeeklyReviewReviewer")
  handoffsCreated                  SignedStudentHandoff[]          @relation("StudentHandoffCreator")
  handoffsAssigned                 SignedStudentHandoff[]          @relation("StudentHandoffButler")
  handoffsAccepted                 SignedStudentHandoff[]          @relation("StudentHandoffAcceptor")
  profileSubmissionsConfirmed      StudentProfileSubmission[]      @relation("StudentProfileConfirmer")

  @@map("users")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique @map("role_code") @db.VarChar(32)
  name        String           @map("role_name") @db.VarChar(50)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique @map("permission_code") @db.VarChar(64)
  name        String           @map("permission_name") @db.VarChar(100)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  effectiveAt DateTime  @default(now()) @map("effective_at")
  expiredAt   DateTime? @map("expired_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash     String    @map("csrf_token_hash") @db.Char(64)
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  idleExpiresAt     DateTime  @map("idle_expires_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  revokedAt         DateTime? @map("revoked_at")
  ipAddress         String?   @map("ip_address") @db.VarChar(64)
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  createdAt         DateTime  @default(now()) @map("created_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operatorId   String?  @map("operator_id") @db.Uuid
  operatorRole String?  @map("operator_role") @db.VarChar(32)
  objectType   String   @map("object_type") @db.VarChar(64)
  objectId     String?  @map("object_id") @db.VarChar(128)
  action       String   @db.VarChar(64)
  beforeData   Json?    @map("before_data")
  afterData    Json?    @map("after_data")
  reason       String?  @db.VarChar(500)
  requestId    String   @map("request_id") @db.VarChar(64)
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  deviceInfo   String?  @map("device_info") @db.VarChar(512)
  createdAt    DateTime @default(now()) @map("created_at")
  operator     User?    @relation("AuditOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([operatorId, createdAt])
  @@index([objectType, objectId])
  @@index([requestId])
  @@map("audit_logs")
}

model Student {
  id                    String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentNo             String                        @unique @map("student_no") @db.VarChar(24)
  name                  String                        @db.VarChar(100)
  phone                 String?                       @db.VarChar(32)
  email                 String?                       @db.VarChar(254)
  englishName           String?                       @map("english_name") @db.VarChar(100)
  school                String?                       @db.VarChar(150)
  grade                 String?                       @db.VarChar(32)
  cohortYear            Int?                          @map("cohort_year")
  studentWechat         String?                       @map("student_wechat") @db.VarChar(100)
  parentName            String?                       @map("parent_name") @db.VarChar(100)
  parentRelationship    String?                       @map("parent_relationship") @db.VarChar(50)
  parentPhone           String?                       @map("parent_phone") @db.VarChar(32)
  parentWechat          String?                       @map("parent_wechat") @db.VarChar(100)
  identityCategory      String?                       @map("identity_category") @db.VarChar(100)
  examCandidateType     String?                       @map("exam_candidate_type") @db.VarChar(100)
  dseSubjects           String[]                      @default([]) @map("dse_subjects")
  scoreSummary          String?                       @map("score_summary") @db.VarChar(1000)
  targetDirection       String?                       @map("target_direction") @db.VarChar(1000)
  profileStatus         StudentProfileStatus          @default(INFORMATION_PENDING) @map("profile_status")
  profileConfirmedAt    DateTime?                     @map("profile_confirmed_at")
  nextMilestone         String?                       @map("next_milestone") @db.VarChar(500)
  riskLevel             StudentRiskLevel              @default(NORMAL) @map("risk_level")
  riskNote              String?                       @map("risk_note") @db.VarChar(1000)
  portalUserId          String?                       @unique @map("portal_user_id") @db.Uuid
  defaultButlerId       String?                       @map("default_butler_id") @db.Uuid
  plannerId             String?                       @map("planner_id") @db.Uuid
  serviceStatus         StudentServiceStatus          @default(NOT_ENABLED) @map("service_status")
  version               Int                           @default(1)
  createdById           String                        @map("created_by") @db.Uuid
  createdAt             DateTime                      @default(now()) @map("created_at")
  updatedAt             DateTime                      @default(now()) @updatedAt @map("updated_at")
  defaultButler         User?                         @relation("StudentDefaultButler", fields: [defaultButlerId], references: [id], onDelete: SetNull)
  planner               User?                         @relation("StudentPlanner", fields: [plannerId], references: [id], onDelete: SetNull)
  portalUser            User?                         @relation("StudentPortalUser", fields: [portalUserId], references: [id], onDelete: SetNull)
  createdBy             User                          @relation("StudentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  responsibilityChanges StudentResponsibilityChange[]
  serviceActivation     StudentServiceActivation?
  stageInstances        StageInstance[]
  taskInstances         TaskInstance[]
  scores                StudentScore[]
  targets               StudentTarget[]
  materialItems         MaterialItem[]
  applications          Application[]
  issues                Issue[]
  confirmations         StudentConfirmation[]
  handoff               SignedStudentHandoff?
  profileSubmission     StudentProfileSubmission?

  @@index([name])
  @@index([serviceStatus, createdAt])
  @@index([defaultButlerId])
  @@index([plannerId])
  @@index([school, grade, cohortYear])
  @@index([riskLevel, updatedAt])
  @@map("students")
}

model SignedStudentHandoff {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentName          String               @map("student_name") @db.VarChar(100)
  studentPhone         String?              @map("student_phone") @db.VarChar(32)
  studentWechat        String?              @map("student_wechat") @db.VarChar(100)
  parentName           String               @map("parent_name") @db.VarChar(100)
  parentRelationship   String?              @map("parent_relationship") @db.VarChar(50)
  parentPhone          String               @map("parent_phone") @db.VarChar(32)
  parentWechat         String?              @map("parent_wechat") @db.VarChar(100)
  school               String?              @db.VarChar(150)
  grade                String?              @db.VarChar(32)
  cohortYear           Int?                 @map("cohort_year")
  assignedButlerId     String               @map("assigned_butler_id") @db.Uuid
  wechatGroupCreatedAt DateTime             @map("wechat_group_created_at")
  status               StudentHandoffStatus @default(PENDING_ACCEPTANCE)
  studentId            String?              @unique @map("student_id") @db.Uuid
  acceptedById         String?              @map("accepted_by_id") @db.Uuid
  acceptedAt           DateTime?            @map("accepted_at")
  version              Int                  @default(1)
  createdById          String               @map("created_by_id") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  assignedButler       User                 @relation("StudentHandoffButler", fields: [assignedButlerId], references: [id], onDelete: Restrict)
  acceptedBy           User?                @relation("StudentHandoffAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  createdBy            User                 @relation("StudentHandoffCreator", fields: [createdById], references: [id], onDelete: Restrict)
  student              Student?             @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([assignedButlerId, status, createdAt])
  @@map("signed_student_handoffs")
}

model StudentProfileSubmission {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId     String    @unique @map("student_id") @db.Uuid
  data          Json
  version       Int       @default(1)
  submittedAt   DateTime  @map("submitted_at")
  confirmedAt   DateTime? @map("confirmed_at")
  confirmedById String?   @map("confirmed_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  confirmedBy   User?     @relation("StudentProfileConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([submittedAt])
  @@map("student_profile_submissions")
}

model StudentResponsibilityChange {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId          String                    @map("student_id") @db.Uuid
  responsibilityType StudentResponsibilityType @map("responsibility_type")
  previousUserId     String?                   @map("previous_user_id") @db.Uuid
  newUserId          String?                   @map("new_user_id") @db.Uuid
  reason             String                    @db.VarChar(500)
  operatorId         String                    @map("operator_id") @db.Uuid
  createdAt          DateTime                  @default(now()) @map("created_at")
  student            Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  previousUser       User?                     @relation("ResponsibilityChangePreviousUser", fields: [previousUserId], references: [id], onDelete: SetNull)
  newUser            User?                     @relation("ResponsibilityChangeNewUser", fields: [newUserId], references: [id], onDelete: SetNull)
  operator           User                      @relation("ResponsibilityChangeOperator", fields: [operatorId], references: [id], onDelete: Restrict)

  @@index([studentId, createdAt])
  @@index([operatorId])
  @@map("student_responsibility_changes")
}

model SopVersion {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionNo          Int                        @unique @map("version_no")
  status             SopVersionStatus           @default(DRAFT)
  sourceVersionId    String?                    @map("source_version_id") @db.Uuid
  publishedAt        DateTime?                  @map("published_at")
  createdById        String                     @map("created_by") @db.Uuid
  version            Int                        @default(1)
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  sourceVersion      SopVersion?                @relation("SopVersionSource", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  derivedVersions    SopVersion[]               @relation("SopVersionSource")
  createdBy          User                       @relation("SopVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  stages             SopStageTemplate[]
  serviceActivations StudentServiceActivation[]
  stageInstances     StageInstance[]
  taskInstances      TaskInstance[]

  @@index([status, createdAt])
  @@map("sop_versions")
}

model SopStageTemplate {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sopVersionId   String                @map("sop_version_id") @db.Uuid
  stageCode      String                @map("stage_code") @db.VarChar(32)
  name           String                @db.VarChar(100)
  sequenceNo     Int                   @map("sequence_no")
  description    String?               @db.VarChar(1000)
  sopVersion     SopVersion            @relation(fields: [sopVersionId], references: [id], onDelete: Cascade)
  tasks          SopTaskTemplate[]
  materials      SopMaterialTemplate[]
  stageInstances StageInstance[]

  @@unique([sopVersionId, stageCode])
  @@unique([sopVersionId, sequenceNo])
  @@map("sop_stage_templates")
}

model SopMaterialTemplate {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateKey        String                  @default(dbgenerated("gen_random_uuid()")) @map("template_key") @db.Uuid
  stageTemplateId    String                  @map("stage_template_id") @db.Uuid
  materialTypeId     String                  @map("material_type_id") @db.Uuid
  title              String                  @db.VarChar(150)
  requirement        String?                 @db.VarChar(2000)
  requirementKind    MaterialRequirementKind @default(REQUIRED) @map("requirement_kind")
  deadlineRule       MaterialDeadlineRule    @default(ACTIVATION_OFFSET) @map("deadline_rule")
  deadlineOffsetDays Int?                    @map("deadline_offset_days")
  fixedDueAt         DateTime?               @map("fixed_due_at")
  conditionRule      Json?                   @map("condition_rule")
  sequenceNo         Int                     @map("sequence_no")
  stageTemplate      SopStageTemplate        @relation(fields: [stageTemplateId], references: [id], onDelete: Cascade)
