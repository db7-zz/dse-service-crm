generator client {
  provider     = "prisma-client"
  output       = "./generated/client"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum StudentServiceStatus {
  NOT_ENABLED
  ENABLED
}

enum StudentResponsibilityType {
  DEFAULT_BUTLER
  PLANNER
}

enum SopVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum OverdueAlertStatus {
  OPEN
  HANDLED
  RESOLVED
}

enum TaskTimelineEventType {
  CREATED
  ASSIGNED
  STARTED
  PROGRESS_UPDATED
  EXTENSION_REPORTED
  RESCHEDULED
  REASSIGNED
  COMPLETED
  CANCELED
  OVERDUE_ALERT_GENERATED
  OVERDUE_ALERT_HANDLED
  OVERDUE_ALERT_RESOLVED
}

model User {
  id                         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                   String      @unique @db.VarChar(64)
  displayName                String      @map("display_name") @db.VarChar(100)
  passwordHash               String      @map("password_hash") @db.VarChar(255)
  status                     UserStatus  @default(ACTIVE)
  failedLoginCount           Int         @default(0) @map("failed_login_count")
  failedLoginWindowStartedAt DateTime?   @map("failed_login_window_started_at")
  lockedUntil                DateTime?   @map("locked_until")
  lastLoginAt                DateTime?   @map("last_login_at")
  createdAt                  DateTime    @default(now()) @map("created_at")
  updatedAt                  DateTime    @updatedAt @map("updated_at")
  roles                      UserRole[]
  sessions                   Session[]
  auditLogs                  AuditLog[]  @relation("AuditOperator")
  studentsCreated            Student[]   @relation("StudentCreator")
  studentsAsDefaultButler    Student[]   @relation("StudentDefaultButler")
  studentsAsPlanner          Student[]   @relation("StudentPlanner")
  responsibilityChangesMade StudentResponsibilityChange[] @relation("ResponsibilityChangeOperator")
  responsibilityChangesFrom StudentResponsibilityChange[] @relation("ResponsibilityChangePreviousUser")
  responsibilityChangesTo   StudentResponsibilityChange[] @relation("ResponsibilityChangeNewUser")
  sopVersionsCreated         SopVersion[]                  @relation("SopVersionCreator")
  serviceActivationsEnabled  StudentServiceActivation[]    @relation("ServiceActivationOperator")
  tasksOwned                 TaskInstance[]                 @relation("TaskOwner")
  taskProgressCreated        TaskProgressRecord[]           @relation("TaskProgressOperator")
  taskExtensionsReported     TaskExtensionReport[]          @relation("TaskExtensionReporter")
  taskDueDatesChanged        TaskDueDateChange[]            @relation("TaskDueDateOperator")
  taskReassignmentsOperated  TaskReassignment[]             @relation("TaskReassignmentOperator")
  taskReassignmentsFrom      TaskReassignment[]             @relation("TaskReassignmentPreviousOwner")
  taskReassignmentsTo        TaskReassignment[]             @relation("TaskReassignmentNewOwner")
  tasksCanceled              TaskInstance[]                 @relation("TaskCancellationOperator")
  overdueAlertsHandled       OverdueAlert[]                 @relation("OverdueAlertHandler")
  taskTimelineEvents         TaskTimelineEvent[]            @relation("TaskTimelineActor")
  taskOperationReceipts      TaskOperationReceipt[]         @relation("TaskOperationActor")

  @@map("users")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique @map("role_code") @db.VarChar(32)
  name        String           @map("role_name") @db.VarChar(50)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique @map("permission_code") @db.VarChar(64)
  name        String           @map("permission_name") @db.VarChar(100)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  effectiveAt DateTime @default(now()) @map("effective_at")
  expiredAt   DateTime? @map("expired_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId      String     @map("role_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  role        Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission  Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash     String    @map("csrf_token_hash") @db.Char(64)
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  idleExpiresAt     DateTime  @map("idle_expires_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  revokedAt         DateTime? @map("revoked_at")
  ipAddress         String?   @map("ip_address") @db.VarChar(64)
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  createdAt         DateTime  @default(now()) @map("created_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operatorId   String?  @map("operator_id") @db.Uuid
  operatorRole String?  @map("operator_role") @db.VarChar(32)
  objectType   String   @map("object_type") @db.VarChar(64)
  objectId     String?  @map("object_id") @db.VarChar(128)
  action       String   @db.VarChar(64)
  beforeData   Json?    @map("before_data")
  afterData    Json?    @map("after_data")
  reason       String?  @db.VarChar(500)
  requestId    String   @map("request_id") @db.VarChar(64)
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  deviceInfo   String?  @map("device_info") @db.VarChar(512)
  createdAt    DateTime @default(now()) @map("created_at")
  operator     User?    @relation("AuditOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([operatorId, createdAt])
  @@index([objectType, objectId])
  @@index([requestId])
  @@map("audit_logs")
}

model Student {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentNo          String               @unique @map("student_no") @db.VarChar(24)
  name               String               @db.VarChar(100)
  phone              String?              @db.VarChar(32)
  email              String?              @db.VarChar(254)
  defaultButlerId    String?              @map("default_butler_id") @db.Uuid
  plannerId          String?              @map("planner_id") @db.Uuid
  serviceStatus      StudentServiceStatus @default(NOT_ENABLED) @map("service_status")
  version            Int                  @default(1)
  createdById        String               @map("created_by") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at")
  defaultButler      User?                @relation("StudentDefaultButler", fields: [defaultButlerId], references: [id], onDelete: SetNull)
  planner            User?                @relation("StudentPlanner", fields: [plannerId], references: [id], onDelete: SetNull)
  createdBy          User                 @relation("StudentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  responsibilityChanges StudentResponsibilityChange[]
  serviceActivation  StudentServiceActivation?
  stageInstances     StageInstance[]
  taskInstances      TaskInstance[]

  @@index([name])
  @@index([serviceStatus, createdAt])
  @@index([defaultButlerId])
  @@index([plannerId])
  @@map("students")
}

model StudentResponsibilityChange {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId          String                    @map("student_id") @db.Uuid
  responsibilityType StudentResponsibilityType @map("responsibility_type")
  previousUserId     String?                   @map("previous_user_id") @db.Uuid
  newUserId          String?                   @map("new_user_id") @db.Uuid
  reason             String                    @db.VarChar(500)
  operatorId         String                    @map("operator_id") @db.Uuid
  createdAt          DateTime                  @default(now()) @map("created_at")
  student            Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  previousUser       User?                     @relation("ResponsibilityChangePreviousUser", fields: [previousUserId], references: [id], onDelete: SetNull)
  newUser            User?                     @relation("ResponsibilityChangeNewUser", fields: [newUserId], references: [id], onDelete: SetNull)
  operator           User                      @relation("ResponsibilityChangeOperator", fields: [operatorId], references: [id], onDelete: Restrict)

  @@index([studentId, createdAt])
  @@index([operatorId])
  @@map("student_responsibility_changes")
}

model SopVersion {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionNo          Int                        @unique @map("version_no")
  status             SopVersionStatus           @default(DRAFT)
  sourceVersionId    String?                    @map("source_version_id") @db.Uuid
  publishedAt        DateTime?                  @map("published_at")
  createdById        String                     @map("created_by") @db.Uuid
  version            Int                        @default(1)
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  sourceVersion      SopVersion?                @relation("SopVersionSource", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  derivedVersions    SopVersion[]               @relation("SopVersionSource")
  createdBy          User                       @relation("SopVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  stages             SopStageTemplate[]
  serviceActivations StudentServiceActivation[]
  stageInstances     StageInstance[]
  taskInstances      TaskInstance[]

  @@index([status, createdAt])
  @@map("sop_versions")
}

model SopStageTemplate {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sopVersionId   String             @map("sop_version_id") @db.Uuid
  stageCode      String             @map("stage_code") @db.VarChar(32)
  name           String             @db.VarChar(100)
  sequenceNo     Int                @map("sequence_no")
  description    String?            @db.VarChar(1000)
  sopVersion     SopVersion         @relation(fields: [sopVersionId], references: [id], onDelete: Cascade)
  tasks          SopTaskTemplate[]
  stageInstances StageInstance[]

  @@unique([sopVersionId, stageCode])
  @@unique([sopVersionId, sequenceNo])
  @@map("sop_stage_templates")
}

model SopTaskTemplate {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stageTemplateId       String            @map("stage_template_id") @db.Uuid
  name                  String            @db.VarChar(150)
  sequenceNo            Int               @map("sequence_no")
  description           String?           @db.VarChar(2000)
  completionCriteria    String?           @map("completion_criteria") @db.VarChar(2000)
  completionWindowHours Int               @map("completion_window_hours")
  ownerRole             String            @default("BUTLER") @map("owner_role") @db.VarChar(32)
  stageTemplate         SopStageTemplate  @relation(fields: [stageTemplateId], references: [id], onDelete: Cascade)
  taskInstances         TaskInstance[]

  @@unique([stageTemplateId, sequenceNo])
  @@map("sop_task_templates")
}

model StudentServiceActivation {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId    String          @unique @map("student_id") @db.Uuid
  sopVersionId String          @map("sop_version_id") @db.Uuid
  enabledById  String          @map("enabled_by") @db.Uuid
  enabledAt    DateTime        @map("enabled_at")
  student      Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  sopVersion   SopVersion      @relation(fields: [sopVersionId], references: [id], onDelete: Restrict)
  enabledBy    User            @relation("ServiceActivationOperator", fields: [enabledById], references: [id], onDelete: Restrict)
  stages       StageInstance[]
  tasks        TaskInstance[]

  @@index([sopVersionId])
  @@map("student_service_activations")
}

model StageInstance {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId           String                    @map("student_id") @db.Uuid
  serviceActivationId String                    @map("service_activation_id") @db.Uuid
  sopVersionId        String                    @map("sop_version_id") @db.Uuid
  stageTemplateId     String                    @map("stage_template_id") @db.Uuid
  stageCodeSnapshot   String                    @map("stage_code_snapshot") @db.VarChar(32)
  nameSnapshot        String                    @map("name_snapshot") @db.VarChar(100)
  sequenceNoSnapshot  Int                       @map("sequence_no_snapshot")
  descriptionSnapshot String?                   @map("description_snapshot") @db.VarChar(1000)
  student             Student                   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  serviceActivation   StudentServiceActivation  @relation(fields: [serviceActivationId], references: [id], onDelete: Restrict)
  sopVersion          SopVersion                @relation(fields: [sopVersionId], references: [id], onDelete: Restrict)
  stageTemplate       SopStageTemplate          @relation(fields: [stageTemplateId], references: [id], onDelete: Restrict)
  tasks               TaskInstance[]

  @@unique([serviceActivationId, stageTemplateId])
  @@unique([serviceActivationId, sequenceNoSnapshot])
  @@index([studentId, sequenceNoSnapshot])
  @@map("stage_instances")
}

model TaskInstance {
  id                            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId                     String                    @map("student_id") @db.Uuid
  serviceActivationId           String                    @map("service_activation_id") @db.Uuid
  stageInstanceId               String                    @map("stage_instance_id") @db.Uuid
  taskTemplateId                String                    @map("task_template_id") @db.Uuid
  sopVersionId                  String                    @map("sop_version_id") @db.Uuid
  titleSnapshot                 String                    @map("title_snapshot") @db.VarChar(150)
  descriptionSnapshot           String?                   @map("description_snapshot") @db.VarChar(2000)
  completionCriteriaSnapshot    String?                   @map("completion_criteria_snapshot") @db.VarChar(2000)
  completionWindowHoursSnapshot Int                       @map("completion_window_hours_snapshot")
  ownerId                       String?                   @map("owner_id") @db.Uuid
  status                        TaskStatus                @default(TODO)
  progressPercent               Int?                      @map("progress_percent")
  originalDueAt                 DateTime                  @map("original_due_at")
  currentDueAt                  DateTime                  @map("current_due_at")
  startedAt                     DateTime?                 @map("started_at")
  completedAt                   DateTime?                 @map("completed_at")
  completionNote                String?                   @map("completion_note") @db.VarChar(2000)
  canceledAt                    DateTime?                 @map("canceled_at")
  canceledById                  String?                   @map("canceled_by") @db.Uuid
  cancelReason                  String?                   @map("cancel_reason") @db.VarChar(500)
  version                       Int                       @default(1)
  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")
  student                       Student                   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  serviceActivation             StudentServiceActivation @relation(fields: [serviceActivationId], references: [id], onDelete: Restrict)
  stageInstance                 StageInstance             @relation(fields: [stageInstanceId], references: [id], onDelete: Restrict)
  taskTemplate                  SopTaskTemplate           @relation(fields: [taskTemplateId], references: [id], onDelete: Restrict)
  sopVersion                    SopVersion                @relation(fields: [sopVersionId], references: [id], onDelete: Restrict)
  owner                         User?                     @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  canceledBy                    User?                     @relation("TaskCancellationOperator", fields: [canceledById], references: [id], onDelete: SetNull)
  progressRecords               TaskProgressRecord[]
  extensionReports              TaskExtensionReport[]
  dueDateChanges                TaskDueDateChange[]
  reassignments                 TaskReassignment[]
  overdueAlerts                 OverdueAlert[]
  timelineEvents                TaskTimelineEvent[]
  operationReceipts             TaskOperationReceipt[]

  @@unique([serviceActivationId, taskTemplateId])
  @@index([ownerId, status, currentDueAt])
  @@index([studentId, status])
  @@index([stageInstanceId])
  @@index([status, currentDueAt])
  @@map("task_instances")
}

model TaskProgressRecord {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId          String       @map("task_id") @db.Uuid
  progressNote    String       @map("progress_note") @db.VarChar(2000)
  progressPercent Int?         @map("progress_percent")
  createdById     String       @map("created_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  task            TaskInstance @relation(fields: [taskId], references: [id], onDelete: Restrict)
  createdBy       User         @relation("TaskProgressOperator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@map("task_progress_records")
}

model TaskExtensionReport {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId           String       @map("task_id") @db.Uuid
  extensionReason  String       @map("extension_reason") @db.VarChar(500)
  expectedFinishAt DateTime     @map("expected_finish_at")
  reportedById     String       @map("reported_by") @db.Uuid
  reportedAt       DateTime     @default(now()) @map("reported_at")
  task             TaskInstance @relation(fields: [taskId], references: [id], onDelete: Restrict)
  reportedBy       User         @relation("TaskExtensionReporter", fields: [reportedById], references: [id], onDelete: Restrict)

  @@index([taskId, reportedAt])
  @@map("task_extension_reports")
}

model TaskDueDateChange {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId       String       @map("task_id") @db.Uuid
  oldDueAt     DateTime     @map("old_due_at")
  newDueAt     DateTime     @map("new_due_at")
  changeReason String       @map("change_reason") @db.VarChar(500)
  operatorId   String       @map("operator_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")
  task         TaskInstance @relation(fields: [taskId], references: [id], onDelete: Restrict)
  operator     User         @relation("TaskDueDateOperator", fields: [operatorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@map("task_due_date_changes")
}

model TaskReassignment {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId         String       @map("task_id") @db.Uuid
  oldOwnerId     String?      @map("old_owner_id") @db.Uuid
  newOwnerId     String       @map("new_owner_id") @db.Uuid
  reassignReason String       @map("reassign_reason") @db.VarChar(500)
  operatorId     String       @map("operator_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  task           TaskInstance @relation(fields: [taskId], references: [id], onDelete: Restrict)
  oldOwner       User?        @relation("TaskReassignmentPreviousOwner", fields: [oldOwnerId], references: [id], onDelete: SetNull)
  newOwner       User         @relation("TaskReassignmentNewOwner", fields: [newOwnerId], references: [id], onDelete: Restrict)
  operator       User         @relation("TaskReassignmentOperator", fields: [operatorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@map("task_reassignments")
}

model OverdueAlert {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId           String             @map("task_id") @db.Uuid
  overdueEpisodeNo Int                @map("overdue_episode_no")
  status           OverdueAlertStatus @default(OPEN)
  firstOverdueAt   DateTime           @map("first_overdue_at")
  generatedAt      DateTime           @default(now()) @map("generated_at")
  handledById      String?            @map("handled_by") @db.Uuid
  handledAt        DateTime?          @map("handled_at")
  resolvedAt       DateTime?          @map("resolved_at")
  resolvedReason   String?            @map("resolved_reason") @db.VarChar(64)
  task             TaskInstance       @relation(fields: [taskId], references: [id], onDelete: Restrict)
  handledBy        User?              @relation("OverdueAlertHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@unique([taskId, overdueEpisodeNo])
  @@index([status, generatedAt])
  @@map("overdue_alerts")
}

model TaskTimelineEvent {
  id         String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId     String                    @map("task_id") @db.Uuid
  eventType  TaskTimelineEventType     @map("event_type")
  actorId    String?                   @map("actor_id") @db.Uuid
  actorRole  String?                   @map("actor_role") @db.VarChar(32)
  summary    String                    @db.VarChar(500)
  reason     String?                   @db.VarChar(500)
  beforeData Json?                     @map("before_data")
  afterData  Json?                     @map("after_data")
  createdAt  DateTime                  @default(now()) @map("created_at")
  task       TaskInstance              @relation(fields: [taskId], references: [id], onDelete: Restrict)
  actor      User?                     @relation("TaskTimelineActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@map("task_timeline_events")
}

model TaskOperationReceipt {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId             String       @map("task_id") @db.Uuid
  actorId            String       @map("actor_id") @db.Uuid
  operation          String       @db.VarChar(64)
  idempotencyKey     String       @map("idempotency_key") @db.VarChar(128)
  requestFingerprint String       @map("request_fingerprint") @db.Char(64)
  responseData       Json         @map("response_data")
  createdAt          DateTime     @default(now()) @map("created_at")
  task               TaskInstance @relation(fields: [taskId], references: [id], onDelete: Restrict)
  actor              User         @relation("TaskOperationActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, operation, idempotencyKey])
  @@index([taskId, createdAt])
  @@map("task_operation_receipts")
}
