  "info": {
    "title": "DSE升学服务CRM API",
    "description": "S1认证、权限、账号、审计与任务监督闭环接口",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "dse_session"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "admin"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 6
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "staff.name"
          },
          "displayName": {
            "type": "string",
            "example": "员工姓名"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 6
          },
          "roleCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ADMINISTRATOR",
                "BUTLER",
                "PLANNER",
                "SPECIALIST",
                "STUDENT"
              ]
            }
          }
        },
        "required": [
          "username",
          "displayName",
          "password",
          "roleCodes"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 6
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "SetUserRolesDto": {
        "type": "object",
        "properties": {
          "roleCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ADMINISTRATOR",
                "BUTLER",
                "PLANNER",
                "SPECIALIST",
                "STUDENT"
              ]
            }
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "roleCodes",
          "reason"
        ]
      },
      "UserStateChangeDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "reason"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "CreateStudentDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "黄翰",
            "maxLength": 100
          },
          "phone": {
            "type": "object",
            "example": "+852 6123 4567",
            "maxLength": 32,
            "nullable": true
          },
          "email": {
            "type": "object",
            "example": "hon.wong@example.com",
            "maxLength": 254,
            "nullable": true
          },
          "defaultButlerId": {
            "type": "object",
            "format": "uuid",
            "nullable": true
          },
          "plannerId": {
            "type": "object",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateStudentDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "phone": {
            "type": "object",
            "maxLength": 32,
            "nullable": true
          },
          "email": {
            "type": "object",
            "maxLength": 254,
            "nullable": true
          },
          "version": {
            "type": "number",
            "minimum": 1,
            "description": "乐观锁版本号"
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "version"
        ]
      },
      "AssignResponsiblePersonDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "object",
            "format": "uuid",
            "nullable": true
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          },
          "version": {
            "type": "number",
            "minimum": 1,
            "description": "乐观锁版本号"
          }
        },
        "required": [
          "userId",
          "reason",
          "version"
        ]
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message",
          "details"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "ApiEnvelope": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "requestId"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "nullable": true
          },
          "error": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ApiError"
              }
            ],
            "nullable": true
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
