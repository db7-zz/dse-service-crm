  "info": {
    "title": "DSE升学服务CRM API",
    "description": "阶段0认证、权限、账号、审计和健康检查接口",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "dse_session"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "admin"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 12
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "staff.name"
          },
          "displayName": {
            "type": "string",
            "example": "员工姓名"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 12
          },
          "roleCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ADMINISTRATOR",
                "ERIC_MANAGER",
                "BUTLER",
                "PLANNER",
                "SPECIALIST",
                "STUDENT"
              ]
            }
          }
        },
        "required": [
          "username",
          "displayName",
          "password",
          "roleCodes"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 12
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "SetUserRolesDto": {
        "type": "object",
        "properties": {
          "roleCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ADMINISTRATOR",
                "ERIC_MANAGER",
                "BUTLER",
                "PLANNER",
                "SPECIALIST",
                "STUDENT"
              ]
            }
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "roleCodes",
          "reason"
        ]
      },
      "UserStateChangeDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "reason"
        ]
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message",
          "details"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "ApiEnvelope": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "requestId"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "nullable": true
          },
          "error": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ApiError"
              }
            ],
            "nullable": true
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
